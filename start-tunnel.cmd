@echo off
rem Второе окно: туннель для Telegram.
rem Он получит публичный HTTPS-адрес и сам пропишет его в бота.
rem Запускайте ПОСЛЕ start.cmd — сервер должен уже работать.
chcp 65001 >nul
title DebtFree - туннель для Telegram
echo.
echo Получаем публичный адрес и настраиваем бота...
echo Это может занять до минуты: скачивается туннель и проверяется Telegram.
echo.
node "%~dp0tools\tunnel.js"
echo.
echo Туннель остановлен. Адрес перестал работать - запустите это окно снова.
pause
