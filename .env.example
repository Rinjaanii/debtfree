# Настройки DebtFree.
#
# Скопируйте этот файл в .env рядом с проектом и заполните своими значениями.
# .env в git не попадает: токен остаётся только у вас.

# Токен бота от @BotFather (/newbot). Без него сервис работает в режиме разработки.
TELEGRAM_BOT_TOKEN=8649136390:AAFb8Y-sDnA7YESYbglVnc0906M4zXu3twA

# Имя бота без @ — чтобы вход в браузере работал одной кнопкой.
TELEGRAM_BOT_USERNAME=free_debt_bot

# Публичный HTTPS-адрес приложения. Нужен Telegram, чтобы открыть мини-аппу.
# Если сервер работает на вашем компьютере — оставьте пустым и запустите
# «node tools/tunnel.js»: скрипт получит адрес и подставит его сюда сам.
PUBLIC_URL=https://getmynumbers.ru

# Порт сервера. По умолчанию 8080.
PORT=8080

# Где хранить данные. По умолчанию папка data рядом с проектом.
# DATA_DIR=
